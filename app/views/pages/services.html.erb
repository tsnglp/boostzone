<% content_for :title, "BoostZone | Our IT Services" %>

<section class="bg-gradient-to-br from-dark via-primary to-primary/80 py-20 text-white">
  <div class="mx-auto w-full max-w-7xl px-6 lg:px-8">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-[0.3em] text-accent">Our IT Services</p>
      <h1 class="mt-4 text-4xl font-semibold sm:text-5xl">Solutions built to support, modernise, and grow your business</h1>
      <p class="mt-6 text-lg leading-8 text-slate-200">BoostZone delivers practical technology services for organisations across NSW and Australia, from modern websites and cloud environments to QA, support, cybersecurity, and vendor management.</p>
    </div>
  </div>
</section>

<section class="py-20">
  <div class="mx-auto w-full max-w-7xl px-6 lg:px-8">
    <div class="grid gap-8 xl:grid-cols-2">
      <% @services.each do |service| %>
        <article id="<%= service[:slug] %>" class="scroll-mt-28 rounded-[2rem] border border-slate-200 bg-white p-8 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-primary/10 lg:p-10">
          <div class="flex flex-col gap-6 sm:flex-row sm:items-start">
            <div class="flex h-16 w-16 items-center justify-center rounded-3xl bg-primary/10 text-primary">
              <%= icon(service[:icon], classes: "h-8 w-8") %>
            </div>
            <div class="flex-1">
              <h2 class="text-2xl font-semibold text-dark"><%= service[:title] %></h2>
              <p class="mt-4 text-base leading-8 text-slate-600"><%= service[:description] %></p>
              <div class="mt-6 rounded-3xl bg-light p-6">
                <p class="text-sm font-semibold uppercase tracking-[0.3em] text-primary">Key Features</p>
                <ul class="mt-4 space-y-3">
                  <% service[:features].each do |feature| %>
                    <li class="flex gap-3 text-slate-700">
                      <span class="mt-1 text-accent">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5" aria-hidden="true">
                          <path fill-rule="evenodd" d="M16.704 5.29a1 1 0 010 1.42l-7.25 7.25a1 1 0 01-1.414 0l-3-3a1 1 0 111.414-1.42l2.293 2.29 6.543-6.54a1 1 0 011.414 0z" clip-rule="evenodd" />
                        </svg>
                      </span>
                      <span><%= feature %></span>
                    </li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        </article>
      <% end %>
    </div>
  </div>
</section>

<section class="bg-dark py-20 text-white">
  <div class="mx-auto flex w-full max-w-7xl flex-col gap-8 px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-[0.3em] text-accent">Need a tailored package?</p>
      <h2 class="mt-4 text-3xl font-semibold sm:text-4xl">Let’s shape the right combination of services for your team.</h2>
      <p class="mt-4 text-lg leading-8 text-slate-200">Whether you need a one-off delivery partner or ongoing support, BoostZone can scope a solution that fits your goals and budget.</p>
    </div>
    <div>
      <%= link_to "Talk to BoostZone", contact_path, class: "inline-flex items-center justify-center rounded-full bg-accent px-6 py-3.5 text-base font-semibold text-dark transition duration-200 hover:bg-white" %>
    </div>
  </div>
</section>
