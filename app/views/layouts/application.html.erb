<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <title><%= content_for(:title) || "BoostZone | IT Services NSW" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="BoostZone">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="description" content="BoostZone delivers smart IT services, web solutions, cloud support, and digital transformation for businesses across NSW and Australia.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-light text-slate-900 antialiased">
    <div class="flex min-h-screen flex-col">
      <header class="sticky top-0 z-50 border-b border-white/10 bg-dark/90 backdrop-blur-xl" data-controller="mobile-menu">
        <div class="mx-auto flex w-full max-w-7xl items-center justify-between px-6 py-4 lg:px-8">
          <%= link_to root_path, class: "flex items-center gap-3" do %>
            <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-accent/15 text-accent ring-1 ring-accent/30">
              <%= icon(:lightning, classes: "h-6 w-6") %>
            </span>
            <span>
              <span class="block text-lg font-semibold tracking-wide text-white">BoostZone</span>
              <span class="block text-xs uppercase tracking-[0.3em] text-slate-400">NSW IT Services</span>
            </span>
          <% end %>

          <nav class="hidden items-center gap-2 md:flex">
            <%= nav_link_to "Home", root_path %>
            <%= nav_link_to "Services", services_path %>
            <%= nav_link_to "About", about_path %>
            <%= nav_link_to "Contact", contact_path %>
            <%= link_to "Get Started", contact_path, class: "ml-3 inline-flex items-center rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-dark transition duration-200 hover:bg-white" %>
          </nav>

          <button type="button" class="inline-flex items-center justify-center rounded-xl border border-white/10 p-3 text-white transition hover:border-accent/50 hover:bg-white/5 md:hidden" data-action="mobile-menu#toggle" aria-label="Toggle navigation">
            <span data-mobile-menu-target="openIcon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="h-6 w-6" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
              </svg>
            </span>
            <span class="hidden" data-mobile-menu-target="closeIcon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="h-6 w-6" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </span>
          </button>
        </div>

        <div class="hidden border-t border-white/10 bg-dark md:hidden" data-mobile-menu-target="panel">
          <div class="space-y-2 px-6 py-4">
            <%= nav_link_to "Home", root_path, mobile: true %>
            <%= nav_link_to "Services", services_path, mobile: true %>
            <%= nav_link_to "About", about_path, mobile: true %>
            <%= nav_link_to "Contact", contact_path, mobile: true %>
            <%= link_to "Get Started", contact_path, class: "mt-2 inline-flex w-full items-center justify-center rounded-xl bg-accent px-4 py-3 text-sm font-semibold text-dark transition duration-200 hover:bg-white", data: { action: "click->mobile-menu#close" } %>
          </div>
        </div>
      </header>

      <main class="flex-1">
        <% flash.each do |type, message| %>
          <div class="mx-auto mt-6 w-full max-w-7xl px-6 lg:px-8">
            <div class="rounded-2xl border px-4 py-4 text-sm font-medium shadow-sm <%= type.to_s == 'alert' ? 'border-amber-300 bg-amber-50 text-amber-900' : 'border-accent/30 bg-accent/10 text-primary' %>">
              <%= message %>
            </div>
          </div>
        <% end %>

        <%= yield %>
      </main>

      <footer class="bg-dark text-slate-300">
        <div class="mx-auto grid w-full max-w-7xl gap-10 px-6 py-14 lg:grid-cols-4 lg:px-8">
          <div>
            <div class="flex items-center gap-3">
              <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-accent/15 text-accent ring-1 ring-accent/30">
                <%= icon(:lightning, classes: "h-6 w-6") %>
              </span>
              <div>
                <p class="text-lg font-semibold text-white">BoostZone</p>
                <p class="text-sm text-slate-400">Professional IT services for modern Australian businesses.</p>
              </div>
            </div>
            <p class="mt-4 text-sm leading-7 text-slate-400">Based in NSW, we help businesses across Australia modernise operations, ship reliable software, and stay supported long after launch.</p>
          </div>

          <div>
            <h3 class="text-sm font-semibold uppercase tracking-[0.3em] text-white/80">Quick Links</h3>
            <ul class="mt-4 space-y-3 text-sm">
              <li><%= link_to "Home", root_path, class: "transition hover:text-white" %></li>
              <li><%= link_to "Services", services_path, class: "transition hover:text-white" %></li>
              <li><%= link_to "About Us", about_path, class: "transition hover:text-white" %></li>
              <li><%= link_to "Contact", contact_path, class: "transition hover:text-white" %></li>
            </ul>
          </div>

          <div>
            <h3 class="text-sm font-semibold uppercase tracking-[0.3em] text-white/80">Popular Services</h3>
            <ul class="mt-4 space-y-3 text-sm">
              <li><%= link_to "Chatbot Development", service_anchor_path("chatbot-development"), class: "transition hover:text-white" %></li>
              <li><%= link_to "Website Design & Development", service_anchor_path("website-design-development"), class: "transition hover:text-white" %></li>
              <li><%= link_to "App Deployment & DevOps", service_anchor_path("app-deployment-devops"), class: "transition hover:text-white" %></li>
              <li><%= link_to "Cloud Infrastructure", service_anchor_path("cloud-infrastructure"), class: "transition hover:text-white" %></li>
            </ul>
          </div>

          <div>
            <h3 class="text-sm font-semibold uppercase tracking-[0.3em] text-white/80">Contact</h3>
            <ul class="mt-4 space-y-4 text-sm text-slate-400">
              <li class="flex gap-3"><span class="mt-0.5 text-accent"><%= icon(:map, classes: "h-5 w-5") %></span><span>NSW, Australia</span></li>
              <li class="flex gap-3"><span class="mt-0.5 text-accent"><%= icon(:mail, classes: "h-5 w-5") %></span><a href="mailto:info@boostzone.com.au" class="transition hover:text-white">hello@boostzone.com.au</a></li>
              <li class="flex gap-3"><span class="mt-0.5 text-accent"><%= icon(:phone, classes: "h-5 w-5") %></span><a href="tel:+61200000000" class="transition hover:text-white">+61 2 XXXX XXXX</a></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-white/10">
          <div class="mx-auto flex w-full max-w-7xl flex-col gap-2 px-6 py-6 text-sm text-slate-500 md:flex-row md:items-center md:justify-between lg:px-8">
            <p>&copy; <%= Time.current.year %> BoostZone. All rights reserved.</p>
            <p>Powering smarter technology outcomes for NSW businesses.</p>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
